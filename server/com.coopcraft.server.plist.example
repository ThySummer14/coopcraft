<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.coopcraft.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-s</string>
		<string>/bin/bash</string>
		<string>/Users/YOURNAME/coopcraft/server/start.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/YOURNAME/coopcraft/server</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>JAVA_HOME</key>
		<string>/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/YOURNAME/coopcraft/server/logs/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOURNAME/coopcraft/server/logs/launchd.err.log</string>
</dict>
</plist>

{
	"schemaVersion": 1,
	"id": "coopcraft",
	"version": "${version}",
	"name": "CoopCraft",
	"description": "A mod built together with friends.",
	"license": "MIT",
	"authors": [
		"ThySummer"
	],
	"contact": {
		"homepage": "https://github.com/ThySummer14/coopcraft",

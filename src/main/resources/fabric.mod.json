{
	"schemaVersion": 1,
	"id": "coopcraft",
	"version": "${version}",
	"name": "CoopCraft",
	"description": "A mod built together with friends.",
	"license": "MIT",
	"authors": [
		"ThySummer"
	],
	"contact": {
		"homepage": "https://github.com/ThySummer14/coopcraft",
		"sources": "https://github.com/ThySummer14/coopcraft",
		"issues": "https://github.com/ThySummer14/coopcraft/issues"
	},
	"icon": "assets/coopcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.thysummer.coopcraft.CoopCraft"
		],
		"client": [
			"com.thysummer.coopcraft.client.CoopCraftClient"
		],
		"fabric-gametest": [
			"com.thysummer.coopcraft.civilization.CivilizationGameTest",
			"com.thysummer.coopcraft.civilization.MinecraftStockpileAdapterGameTest",
			"com.thysummer.coopcraft.civilization.SettlementSimulationStateGameTest",
			"com.thysummer.coopcraft.civilization.SettlementSurvivalGameTest"
		]
	},
	"mixins": [
		"coopcraft.mixins.json",
		{
			"config": "coopcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "coopcraft.accesswidener",
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
